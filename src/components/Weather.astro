---
import {ui} from '../i18n';
import {getWeather,wmoLabel,beaufort,dayName,buildAdvice,digitFormat} from '../lib/weather';
interface Props{id?:string;locale?:'ur'|'en'}
const {id,locale='ur'}=Astro.props,T=ui[locale],en=locale==='en';
const wx=await getWeather();
const num=(n:unknown)=>typeof n==='number'&&Number.isFinite(n)?digitFormat(Math.round(n),locale):'—';
const advice=wx?buildAdvice(wx.current,{precipitation_probability_max:wx.daily.precipitation_probability_max[0],uv_index_max:wx.daily.uv_index_max[0],temperature_2m_max:wx.daily.temperature_2m_max[0]},locale):null;
const snapshot=JSON.stringify(wx).replace(/</g,'\u003c');
---
<section id={id??T.nav[5].id}>
 <div class="section-head"><span class="eyebrow">{T.weather.eyebrow}</span><h2>{T.weather.h2}</h2><p>{T.weather.p}</p></div>
 <div class="weather-panel" id="weather-panel" data-locale={locale}>
 {wx?<>
  <div class="current"><div class="c-main"><div class="c-temp"><bdi dir="ltr">{num(wx.current.temperature_2m)} °C</bdi></div><div class="c-cond">{wmoLabel(wx.current.weather_code,locale)}</div></div>
  <div class="c-meta"><p>{en?'Feels like':'محسوس'}: <bdi dir="ltr">{num(wx.current.apparent_temperature)} °C</bdi></p><p>{en?'Humidity':'نمی'}: <bdi dir="ltr">{num(wx.current.relative_humidity_2m)}%</bdi></p><p>{en?'Wind':'ہوا'}: <bdi dir="ltr">{num(wx.current.wind_speed_10m)} km/h</bdi> · {beaufort(wx.current.wind_speed_10m,locale).label}</p><p>{en?'Rain probability':'بارش کا امکان'}: <bdi dir="ltr">{num(wx.daily.precipitation_probability_max[0])}{wx.daily.precipitation_probability_max[0]===null?'':'%'}</bdi></p></div></div>
  <div class="advice">{advice?.notes.map(note=><p>{note}</p>)}</div>
  <div class="forecast">{wx.daily.time.map((day,i)=><div class="f-day"><div class="f-name">{dayName(i,day,locale)}</div><div class="f-cond">{wmoLabel(wx.daily.weather_code[i],locale)}</div><div class="f-temp"><bdi dir="ltr">{num(wx.daily.temperature_2m_max[i])}° / {num(wx.daily.temperature_2m_min[i])}°</bdi></div><div class="f-pop">{en?'Rain probability':'بارش کا امکان'}: <bdi dir="ltr">{num(wx.daily.precipitation_probability_max[i])}{wx.daily.precipitation_probability_max[i]===null?'':'%'}</bdi></div><div class="f-uv">UV: <bdi dir="ltr">{num(wx.daily.uv_index_max[i])}</bdi></div></div>)}</div>
  <p class="fine">{en?'Provider time':'فراہم کنندہ کا وقت'}: <bdi dir="ltr">{wx.current.time.replace('T',' ')} · Asia/Karachi (UTC+5)</bdi></p>
 </>:<p class="fine">{T.weather.nowUnavailable}</p>}
 </div>
 <p class="fine">{en?'Open-Meteo model for the fort area, not an on-site observation or a notice about access. Check official weather warnings and monument instructions.':'قلعے کے علاقے کے لیے Open-Meteo ماڈل ہے، مقام کی پیمائش یا داخلے کی اطلاع نہیں۔ سرکاری موسمی انتباہ اور قلعے کی ہدایات دیکھیں۔'}</p>
 <noscript><p class="fine">{en?'The dated build snapshot cannot refresh without JavaScript; check a current official forecast.':'جاوا اسکرپٹ کے بغیر درج شدہ پرانی پیش گوئی تازہ نہیں ہو سکتی؛ موجودہ سرکاری موسمی اطلاع دیکھیں۔'}</p></noscript>
</section>
<script is:inline type="application/json" id="weather-snapshot" set:html={snapshot}></script>
<script>import {initWeather} from '../lib/weather-client.js';initWeather();</script>
