---
interface Props { locale?: 'ur' | 'en'; }
const { locale = 'ur' } = Astro.props;
import { ui } from '../i18n';
import {
  AUTHORITY_SOURCES,
  AUTHORITY_SOURCES_EN,
  MAPS_SHARE_URL,
  TELEPHONE_DISPLAY
} from '../data/site';
const T = ui[locale];
const sources = locale === 'en' ? AUTHORITY_SOURCES_EN : AUTHORITY_SOURCES;
const legalBase = locale === 'en' ? '/en/' : '/';
const helpNote =
  locale === 'en'
    ? 'Independent nonprofit editorial guide; not the operator, WCLA or UNESCO. Sources checked 25 October 2026. Confirm access with the operator before travelling.'
    : 'آزاد، غیر منافع بخش ادارتی رہنما؛ قلعے کے منتظم، والڈ سٹی اتھارٹی یا یونیسکو سے وابستہ نہیں۔ ماخذ 25 اکتوبر 2026 کو دیکھے گئے؛ سفر سے پہلے رسائی کی تصدیق کریں۔';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h3>{T.meta.siteName}</h3>
        <p class="muted">{T.footer.desc}</p>
        <p class="muted small">{helpNote}</p>
        <p class="muted small">
          <a href={MAPS_SHARE_URL} target="_blank" rel="noopener" dir="ltr">Google Maps</a>
          {' · '}
          <span>{locale==='en'?'Maps-listed number (operator not verified): ':'نقشے پر درج نمبر (منتظم کی تصدیق نہیں): '}<bdi dir="ltr">{TELEPHONE_DISPLAY}</bdi></span>
        </p>
      </div>
      <div>
        <h4>{T.footer.legalLabel}</h4>
        <ul class="footer-links">
          <li><a href="/CREDITS.txt">{locale==='en'?'Photograph credits and licences':'تصاویر کے مصنف اور اجازت نامے'}</a></li>
          <li><a href={`${legalBase}raazdari/`}>{T.meta.privacyTitle}</a></li>
          <li><a href={`${legalBase}sharaait/`}>{T.meta.termsTitle}</a></li>
          <li><a href={`${legalBase}cookies/`}>{T.meta.cookiesTitle}</a></li>
        </ul>
      </div>
      <div>
        <h4>{locale === 'en' ? 'Reference sources' : 'حوالہ جات'}</h4>
        <ul class="src-list">
          {sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <p class="fine footer-fine">{T.footer.fine1}</p>
    <p class="fine footer-fine">{T.footer.fine2}</p>
    <p class="fine footer-fine">{T.footer.fine3} {T.meta.siteName}</p>
  </div>
</footer>
