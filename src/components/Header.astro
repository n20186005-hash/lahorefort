---
interface Props { locale?: 'ur' | 'en'; otherHref?: string; }
const { locale = 'ur', otherHref: pairedHref } = Astro.props;
import { ui } from '../i18n';
import { SITE_NAME, SITE_NAME_EN } from '../data/site';
const T = ui[locale];
const homeHref = locale === 'en' ? '/en/' : '/';
const otherHref = pairedHref ?? (locale === 'en' ? '/' : '/en/');
const switchLabel = locale === 'en' ? 'اردو' : 'English';
const brand = locale === 'en' ? SITE_NAME_EN : SITE_NAME;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={homeHref}>
      <span class="brand-mark" aria-hidden="true">🏰</span>
      <span class="brand-text">{brand}</span>
    </a>
    <input type="checkbox" id="navtoggle" class="nav-toggle" />
    <label for="navtoggle" class="nav-toggle-label" aria-label="Menu"><span></span></label>
    <nav class="site-nav" aria-label="Primary">
      {T.nav.map((n) => (
        <a href={`${homeHref}#${n.id}`}>{n.label}</a>
      ))}
      <a href={locale==='en'?'/en/guides/':'/guides/'}>{locale==='en'?'Guides':'تفصیلی رہنما'}</a>
      <a class="lang-switch" href={otherHref} hreflang={locale === 'en' ? 'ur' : 'en'}>{switchLabel}</a>
    </nav>
  </div>
</header>
