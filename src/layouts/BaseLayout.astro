---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; image?: string; imageAlt?: string; schema?: unknown[]; robots?: string; }
const { title, description, image='/images/alamgiri-gate.jpg', imageAlt='قلعہ لاہور (Lahore Fort) کا تاریخی عالمگیری دروازہ — اندرون شہر لاہور، پنجاب، پاکستان', schema=[], robots='index' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : undefined;
const robotsMeta = robots === 'noindex' ? 'noindex,follow' : 'index,follow,max-image-preview:large';
---
<!doctype html>
<html lang="ur" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsMeta} />
  <meta name="theme-color" content="#6d281d" />
  <link rel="manifest" href="/manifest.webmanifest" />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ur_PK" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:alt" content={imageAlt} />}
  {schema.map((item) => <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />)}
  <script is:inline>
    (()=>{try{const p=JSON.parse(localStorage.getItem('lahoreFortConsent')||'{}');if(p.analytics===true){const s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';document.head.appendChild(s);window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','G-HXM22WWPKP',{anonymize_ip:true});}}catch(e){}})();
    if('serviceWorker' in navigator && location.protocol==='https:'){
      addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})});
    }
  </script>
</head>
<body>
  <a class="skip" href="#مرکزی-مواد">مرکزی مواد پر جائیں</a>
  <Header />
  <main id="مرکزی-مواد"><slot /></main>
  <Footer />
</body>
</html>