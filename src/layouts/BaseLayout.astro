---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n';
import { SITE_NAME, SITE_NAME_EN, GA4_ID, HERO_IMAGE_ALT } from '../data/site';

interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  locale?: 'ur' | 'en';
  crumbs?: Crumb[];
}

const { title, description, noindex = false, locale = 'ur', crumbs } = Astro.props;
const T = ui[locale];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const desc = description ?? T.meta.homeDesc;
const siteName = locale === 'en' ? SITE_NAME_EN : SITE_NAME;
const homeHref = locale === 'en' ? '/en/' : '/';
const homeLabel = locale === 'en' ? 'Home' : 'مرکزی صفحہ';

// Build hreflang alternates for the current page pair: /<path> (ur) and /en/<path> (en).
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en/') || pathname === '/en';
const base = isEn ? pathname.replace(/^\/en/, '') || '/' : pathname;
const urHref = new URL(base === '/' ? '/' : base, Astro.site).href;
const enHref = new URL('/en' + (base === '/' ? '/' : base), Astro.site).href;
---

<!doctype html>
<html lang={T.htmlLang} dir={T.htmlDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? siteName}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#6d281d" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://www.google.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={urHref} />}
    {canonical && <link rel="alternate" hreflang="ur-PK" href={urHref} />}
    {canonical && <link rel="alternate" hreflang="en" href={enHref} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/alamgiri-gate.jpg', Astro.site).href} />
    <meta property="og:image:alt" content={locale === 'en' ? 'Lahore Fort — the historic Alamgiri Gate' : HERO_IMAGE_ALT} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ur_PK'} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body>
    <Header locale={locale} />
    {
      crumbs && crumbs.length > 0 && (
        <nav class="crumbs" aria-label={locale === 'en' ? 'Breadcrumb' : 'روٹ'}>
          <div class="wrap">
            <a href={homeHref}>{homeLabel}</a>
            <span class="sep" aria-hidden="true">/</span>
            {crumbs.map((c, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                {c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
              </>
            ))}
          </div>
        </nav>
      )
    }
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    {GA4_ID && (
      <script is:inline define:vars={{ GA4_ID }} define_global={true}>
        (function () {
          var allowed = false;
          try {
            var c = JSON.parse(localStorage.getItem('lahoreFortConsent') || '{}');
            allowed = c && c.analytics === true;
          } catch (e) {}
          if (!allowed) return;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA4_ID, { anonymize_ip: true });
        })();
      </script>
    )}
  </body>
</html>
