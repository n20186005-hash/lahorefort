---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName, DESCRIPTIONS } from '../data/site';
---
<BaseLayout noindex title={withSiteName('ur', 'کوکی ترتیبات')} description={DESCRIPTIONS.cookies} crumbs={[{ name: 'کوکی ترتیبات' }]}>
<section class="legal"><p class="eyebrow">آخری تازہ کاری: 25 اکتوبر 2026</p><h1>کوکی ترتیبات</h1><p>آپ اپنی ترجیحات یہاں سنبھال سکتے ہیں۔ ضروری تکنیکی ذخیرہ سائٹ کی بنیادی فعالیت اور آپ کی رضامندی یاد رکھنے کے لیے استعمال ہوتا ہے۔</p><div class="cookie-grid"><label class="cookie-row"><span><strong>ضروری کوکی/مقامی ذخیرہ</strong><br/>بنیادی سائٹ اور رضامندی کی ترجیح کے لیے ضروری؛ اسے بند نہیں کیا جا سکتا۔</span><input type="checkbox" checked disabled /></label><label class="cookie-row"><span><strong>تجزیاتی کوکی</strong><br/>گوگل اینالیٹکس <span dir="ltr">G-HXM22WWPKP</span> صرف اجازت کے بعد لوڈ ہوگا اور مجموعی استعمال سمجھنے میں مدد دے گا۔</span><input id="analytics" type="checkbox" /></label><label class="cookie-row"><span><strong>ترجیحی ذخیرہ</strong><br/>یہ نشان آپ کا انتخاب محفوظ کرتا ہے؛ تھیم یا زبان خود بحال کرنے کا وعدہ نہیں۔ زبان URL سے طے ہوتی ہے۔</span><input id="preferences" type="checkbox" /></label><label class="cookie-row"><span><strong>مارکیٹنگ کوکی</strong><br/>اس وقت ویب سائٹ ذاتی نوعیت کے اشتہارات نہیں چلاتی؛ اختیار بطور پیشگی ترجیح بند رکھا گیا ہے۔</span><input id="marketing" type="checkbox" disabled /></label></div><div class="cookie-actions"><button class="save" id="save">ترجیحات محفوظ کریں</button><button class="reject" id="reject">غیر ضروری سب رد کریں</button></div><p id="status" role="status" aria-live="polite"></p><h2>رضامندی کا انتظام</h2><p>آپ یہ ترتیبات کسی بھی وقت دوبارہ بدل سکتے ہیں۔ کامیاب اجازت کے بعد Google Analytics فوراً لوڈ ہو سکتا ہے۔ اجازت واپس لینا اس صفحے پر فوراً بند کرتا ہے؛ محفوظ کرنا ناکام ہو تو پیغام آئندہ صفحوں کے لیے باقی خطرہ بتاتا ہے۔ پہلے سے تیسرے فریق کے پاس بھیجا گیا ڈیٹا ان کی متعلقہ پالیسی کے تابع رہتا ہے۔</p></section>  <script is:inline>
 document.addEventListener('DOMContentLoaded',()=>{const api=window.lahoreAnalytics,a=document.getElementById('analytics'),p=document.getElementById('preferences'),s=document.getElementById('status');if(!api||!a||!p||!s)return;a.checked=api.get();try{p.checked=JSON.parse(localStorage.getItem('lahoreFortConsent')||'{}').preferences===true;}catch{}const save=allow=>{const r=api.set(allow,p.checked);a.checked=r.effective;s.textContent=r.saved?"انتخاب محفوظ ہے۔ اجازت کے بعد تجزیہ فوراً شروع ہو سکتا ہے؛ انکار اگلی پیمائش روکتا ہے، پہلے بھیجا گیا ڈیٹا واپس نہیں لیتا۔":(r.sharedOff?"اس صفحے پر تجزیہ بند ہے اور مشترک انکار کی تصدیق ہوئی، مگر مطلوبہ ترتیبات محفوظ نہیں ہو سکیں۔":"اس صفحے پر تجزیہ بند ہے۔ محفوظ کرنا ناکام رہا؛ دوسرے صفحے یا آئندہ دورے میں پرانا انتخاب پڑھا جا سکتا ہے۔ دوبارہ کوشش کریں یا اس سائٹ کا محفوظ انتخاب صاف کریں۔");};document.getElementById('save')?.addEventListener('click',()=>save(a.checked));document.getElementById('reject')?.addEventListener('click',()=>{p.checked=false;save(false);});});
 </script>
</BaseLayout>
