---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="کوکی ترتیبات | قلعہ لاہور سیاحتی رہنما" description="ضروری، تجزیاتی، ترجیحی اور مارکیٹنگ کوکی ترجیحات کا انتظام کریں۔"><section class="legal"><p class="eyebrow">آخری تازہ کاری: ستمبر 2026</p><h1>کوکی ترتیبات</h1><p>آپ اپنی ترجیحات یہاں سنبھال سکتے ہیں۔ ضروری تکنیکی ذخیرہ سائٹ کی بنیادی فعالیت اور آپ کی رضامندی یاد رکھنے کے لیے استعمال ہوتا ہے۔</p><div class="cookie-grid"><label class="cookie-row"><span><strong>ضروری کوکی/مقامی ذخیرہ</strong><br/>بنیادی سائٹ اور رضامندی کی ترجیح کے لیے ضروری؛ اسے بند نہیں کیا جا سکتا۔</span><input type="checkbox" checked disabled /></label><label class="cookie-row"><span><strong>تجزیاتی کوکی</strong><br/>گوگل اینالیٹکس <span dir="ltr">G-HXM22WWPKP</span> صرف اجازت کے بعد لوڈ ہوگا اور مجموعی استعمال سمجھنے میں مدد دے گا۔</span><input id="analytics" type="checkbox" /></label><label class="cookie-row"><span><strong>ترجیحی ذخیرہ</strong><br/>مستقبل میں دستیاب ظاہری یا صارف ترجیحات محفوظ کرنے کی اجازت۔</span><input id="preferences" type="checkbox" /></label><label class="cookie-row"><span><strong>مارکیٹنگ کوکی</strong><br/>اس وقت ویب سائٹ ذاتی نوعیت کے اشتہارات نہیں چلاتی؛ اختیار بطور پیشگی ترجیح بند رکھا گیا ہے۔</span><input id="marketing" type="checkbox" disabled /></label></div><div class="cookie-actions"><button class="save" id="save">ترجیحات محفوظ کریں</button><button class="reject" id="reject">غیر ضروری سب رد کریں</button></div><p id="status" role="status" aria-live="polite"></p><h2>رضامندی کا انتظام</h2><p>آپ یہ ترتیبات کسی بھی وقت دوبارہ بدل سکتے ہیں۔ تجزیاتی اجازت بند کرنے کے بعد آئندہ صفحہ لوڈ پر گوگل اینالیٹکس لوڈ نہیں ہوگا۔ پہلے سے تیسرے فریق کے پاس بھیجا گیا ڈیٹا ان کی متعلقہ پالیسی کے تابع رہتا ہے۔</p></section><script is:inline>
const key='lahoreFortConsent';const a=document.getElementById('analytics');const p=document.getElementById('preferences');const s=document.getElementById('status');try{const v=JSON.parse(localStorage.getItem(key)||'{}');a.checked=v.analytics===true;p.checked=v.preferences===true}catch(e){}document.getElementById('save').addEventListener('click',()=>{localStorage.setItem(key,JSON.stringify({necessary:true,analytics:a.checked,preferences:p.checked,marketing:false}));s.textContent='آپ کی ترجیحات محفوظ ہو گئی ہیں۔ تبدیلی مکمل طور پر نافذ کرنے کے لیے صفحہ دوبارہ کھولیں۔'});document.getElementById('reject').addEventListener('click',()=>{a.checked=false;p.checked=false;localStorage.setItem(key,JSON.stringify({necessary:true,analytics:false,preferences:false,marketing:false}));s.textContent='تمام غیر ضروری اختیارات بند کر دیے گئے ہیں۔'});
</script></BaseLayout>