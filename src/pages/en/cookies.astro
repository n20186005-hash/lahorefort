---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withSiteName } from '../../data/site';
const locale = 'en' as const;
const title = withSiteName(locale, 'Cookie Settings');
---

<BaseLayout title={title} description="Manage essential, analytics, preferences and marketing cookie choices." locale={locale} noindex={true}>
  <section class="legal">
    <div class="wrap legal-wrap">
      <h1>{title}</h1>
      <p class="eyebrow">Last updated: 25 October 2026</p>
      <p>
        Manage your cookie preferences below. Essential technical storage is required for the site to function
        and to remember your consent choice; it cannot be turned off. Other categories load only after you grant
        consent through this page.
      </p>
      <div class="cookie-grid">
        <label class="cookie-row">
          <span><strong>Essential cookies / local storage</strong><br/>Required for basic site function and to remember your consent preference; cannot be disabled.</span>
          <input type="checkbox" checked disabled />
        </label>
        <label class="cookie-row">
          <span><strong>Analytics cookies</strong><br/>Google Analytics <span dir="ltr">G-HXM22WWPKP</span> loads only after permission and helps understand overall usage.</span>
          <input id="analytics" type="checkbox" />
        </label>
        <label class="cookie-row">
          <span><strong>Preference storage</strong><br/>Records this choice without automatically restoring a theme or language. The URL determines the language.</span>
          <input id="preferences" type="checkbox" />
        </label>
        <label class="cookie-row">
          <span><strong>Marketing cookies</strong><br/>This guide does not currently run personalised ads; kept off by default as a forward-looking option.</span>
          <input id="marketing" type="checkbox" disabled />
        </label>
      </div>
      <div class="cookie-actions">
        <button class="save" id="save">Save preferences</button>
        <button class="reject" id="reject">Reject all non-essential</button>
      </div>
      <p id="status" role="status" aria-live="polite"></p>

      <h2>Managing consent</h2>
      <p>You can change these settings at any time. A successfully saved allowance may load Google Analytics immediately. Withdrawal turns it off on this page immediately; a failed save message explains the remaining risk for future pages. Data already sent to third parties remains subject to their respective policies.</p>
      <p><a class="btn btn-ghost" href="/en/">← Back to home</a></p>
    </div>
  </section>
    <script is:inline>
 document.addEventListener('DOMContentLoaded',()=>{const api=window.lahoreAnalytics,a=document.getElementById('analytics'),p=document.getElementById('preferences'),s=document.getElementById('status');if(!api||!a||!p||!s)return;a.checked=api.get();try{p.checked=JSON.parse(localStorage.getItem('lahoreFortConsent')||'{}').preferences===true;}catch{}const save=allow=>{const r=api.set(allow,p.checked);a.checked=r.effective;s.textContent=r.saved?"Your choice is saved. Allowing analytics can load it immediately; withdrawal stops future measurement but cannot recall earlier data.":(r.sharedOff?"Analytics is off on this page and shared refusal is confirmed; the requested settings could not be saved.":"Analytics is off on this page. Saving failed; another page or future visit may read an older choice. Try again or clear this site’s stored choice.");};document.getElementById('save')?.addEventListener('click',()=>save(a.checked));document.getElementById('reject')?.addEventListener('click',()=>{p.checked=false;save(false);});});
 </script>
</BaseLayout>
