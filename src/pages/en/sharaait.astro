---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withSiteName } from '../../data/site';
const locale = 'en' as const;
const title = withSiteName(locale, 'Terms of Service');
---

<BaseLayout title={title} description="Terms of service for the independent Lahore Fort travel guide." locale={locale} noindex={true}>
  <section class="legal">
    <div class="wrap legal-wrap">
      <h1>{title}</h1>
      <p>
        By using this guide you agree to the following simple terms. This is an independent, non-profit
        information project and is not an official government or commercial service.
      </p>

      <h2>Content is informational</h2>
      <p>
        All content is provided for general travel information. Confirm tickets, opening hours, fees and
        access with the official authorities before you travel.
      </p>

      <h2>No commercial recommendation</h2>
      <p>
        We do not recommend or endorse any specific shop, hotel, restaurant or business; mentions of
        facilities are by type only.
      </p>

      <h2>External resources</h2>
      <p>
        Links to third-party sites and maps are provided for convenience; we are not responsible for their
        content or accuracy.
      </p>

      <h2>Intellectual property</h2>
      <p>
        Text is provided under an open licence for non-commercial sharing with attribution (see
        IMAGE-CREDITS.md). Images remain the property of their original authors.
      </p>

      <h2>Limitation of liability</h2>
      <p>Use the information at your own risk; we are not liable for any loss arising from reliance on it.</p>

      <h2>Changes</h2>
      <p>These terms may change; the effective date is shown below.</p>

      <p class="fine">Effective: 2026-09-17</p>
      <p><a class="btn btn-ghost" href="/en/">← Back to home</a></p>
    </div>
  </section>
</BaseLayout>
