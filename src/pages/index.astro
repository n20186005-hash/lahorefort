---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuidePage from '../components/GuidePage.astro';
import { ui } from '../i18n';
const locale = 'ur' as const;
const T = ui[locale];
---

<BaseLayout title={T.meta.homeTitle} description={T.meta.homeDesc} locale={locale}>
  <GuidePage locale={locale} />
</BaseLayout>
